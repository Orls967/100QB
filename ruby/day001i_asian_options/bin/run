#!/usr/bin/env ruby
# frozen_string_literal: true

RubyVM::YJIT.enable if defined?(RubyVM::YJIT) && RubyVM::YJIT.respond_to?(:enable) && !RubyVM::YJIT.enabled?

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'optparse'
require 'asian_options'

options = {
  n_paths: AsianOptions::DEFAULT_N_PATHS,
  seed: AsianOptions::DEFAULT_SEED,
  workers: nil
}

OptionParser.new do |opts|
  opts.banner = 'Usage: bin/run [options]'
  opts.on('-n', '--paths N', Integer, 'Jumlah path Monte Carlo (default: 200000)') { |v| options[:n_paths] = v }
  opts.on('-s', '--seed SEED', Integer, 'Seed PRNG utama (default: 42)') { |v| options[:seed] = v }
  opts.on('-w', '--workers W', Integer, 'Jumlah proses worker fork (default: semua core)') { |v| options[:workers] = v }
end.parse!

runner = AsianOptions::Runner.new(
  params: AsianOptions::DEFAULT_PARAMS,
  n_paths: options[:n_paths],
  seed: options[:seed],
  workers: options[:workers]
)

result = runner.execute
repo_root = AsianOptions::Runner.find_repo_root(__dir__)
paths = runner.write_outputs(result, repo_root: repo_root)

payload = result[:payload]
sanity = payload[:sanity_check]
cv_est = payload[:estimators][2]
delta = payload[:delta]
slopes = payload[:slopes]
timings = payload[:timings_ms]

yjit_status = defined?(RubyVM::YJIT) && RubyVM::YJIT.enabled? ? 'ON' : 'OFF'
puts format(
  'Ruby %<ver>s | YJIT: %<yjit>s | Workers: %<workers>d',
  ver: RUBY_VERSION, yjit: yjit_status, workers: AsianOptions::Parallel.resolve_workers(options[:workers])
)
puts format(
  'BS Eropa: %<bs>.17g | MC Eropa: %<mc>.6f ± %<se>.6f (%<z>.2f SE)',
  bs: sanity[:bs_call], mc: sanity[:mc_call][:price], se: sanity[:mc_call][:se], z: sanity[:z_score]
)
puts format('Geom. Asian exact: %<exact>.17g | beta: %<beta>.6f', exact: cv_est[:y_exact], beta: cv_est[:beta])
payload[:estimators].each do |est|
  puts format(
    '%<name>-28s: %<price>.6f ± %<se>.6f (CI [%<low>.6f, %<high>.6f]) | VRF = %<vrf>.2fx',
    name: est[:name], price: est[:price], se: est[:se],
    low: est[:ci_low], high: est[:ci_high], vrf: est[:vrf]
  )
end
puts format(
  'Delta PW: %<pw>.6f ± %<pw_se>.6f | Bump: %<bmp>.6f ± %<bmp_se>.6f | diff = %<diff>+.6f (%<z>.2f SE)',
  pw: delta[:pathwise][:delta], pw_se: delta[:pathwise][:se],
  bmp: delta[:bump_1pct][:delta], bmp_se: delta[:bump_1pct][:se],
  diff: delta[:diff], z: delta[:z_score]
)
puts format(
  'Slopes -> Naive: %<naive>.4f, Antithetic: %<anti>.4f, CV: %<cv>.4f',
  naive: slopes[:naive], anti: slopes[:antithetic], cv: slopes[:control_variate]
)
puts format(
  'Total 200k core time: %<core>.1f ms | Convergence: %<conv>.1f ms',
  core: timings[:total_200k_core], conv: timings[:convergence]
)
puts "Output JSON: #{paths[:json]}"
puts "Output SVG : #{paths[:svg_convergence]}, #{paths[:svg_estimators]}"
