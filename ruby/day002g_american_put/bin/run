#!/usr/bin/env ruby
# frozen_string_literal: true

RubyVM::YJIT.enable if defined?(RubyVM::YJIT) && RubyVM::YJIT.respond_to?(:enable) && !RubyVM::YJIT.enabled?

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'optparse'
require 'american_put'

options = {
  seed: AmericanPut::DEFAULT_SEED,
  workers: nil
}

OptionParser.new do |opts|
  opts.banner = 'Usage: bin/run [options]'
  opts.on('-s', '--seed SEED', Integer, 'Seed PRNG utama (default: 42)') { |v| options[:seed] = v }
  opts.on('-w', '--workers W', Integer, 'Jumlah proses worker fork (default: semua core)') { |v| options[:workers] = v }
end.parse!

runner = AmericanPut::Runner.new(seed: options[:seed], workers: options[:workers])
result = runner.execute
repo_root = AmericanPut::Runner.find_repo_root(__dir__)
paths = runner.write_outputs(result, repo_root: repo_root)

p = result[:payload]
yjit_status = defined?(RubyVM::YJIT) && RubyVM::YJIT.enabled? ? 'ON' : 'OFF'
puts format('Ruby %<ver>s | YJIT: %<yjit>s | Workers: %<w>d',
            ver: RUBY_VERSION, yjit: yjit_status, w: AmericanPut::Parallel.resolve_workers(options[:workers]))
puts format('BS Put Eropa (exact)      : %.8f', p[:bs_european_put])
puts format('CRR Binomial (n=%<n>d)     : %<am>.8f | EU: %<eu>.8f | EEP: %<eep>.6f',
            n: p[:crr][:n_steps], am: p[:crr][:american_price],
            eu: p[:crr][:european_price], eep: p[:crr][:early_exercise_premium])
puts format('PSOR PDE (%<nx>dx%<nt>d)       : %<am>.8f | EU: %<eu>.8f | avg sweeps: %<sw>.1f',
            nx: p[:psor][:n_x], nt: p[:psor][:n_t], am: p[:psor][:american_price],
            eu: p[:psor][:european_price], sw: p[:psor][:avg_sweeps])
puts format('LSM MC (%<n>d x %<m>d)     : %<pr>.6f ± %<se>.6f (CI [%<lo>.6f, %<hi>.6f])',
            n: p[:lsm][:n_paths], m: p[:lsm][:n_steps], pr: p[:lsm][:price],
            se: p[:lsm][:se], lo: p[:lsm][:ci_low], hi: p[:lsm][:ci_high])
puts format('Cross-check CRR vs PSOR   : %<diff>+.6e | LSM vs CRR: %<z>.2f SE',
            diff: p[:cross_check][:crr_vs_psor_diff], z: p[:cross_check][:lsm_vs_crr_z])
puts format('Timings (ms) -> CRR: %<crr>.1f | LSM: %<lsm>.1f | PSOR: %<psor>.1f | Total core: %<tot>.1f',
            crr: p[:timings_ms][:crr_ms], lsm: p[:timings_ms][:lsm_ms],
            psor: p[:timings_ms][:psor_ms], tot: p[:timings_ms][:core_total_ms])
puts "Output JSON: #{paths[:json]}"
puts "Output SVG : #{paths[:svg_convergence]}, #{paths[:svg_spot]}"
