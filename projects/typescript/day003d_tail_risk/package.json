{
  "name": "day003d_tail_risk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tail risk modeling in pure TypeScript: exact distributions, GARCH-t, EVT (POT/Hill), conditional VaR/ES, and Kupiec/Christoffersen/Acerbi-Szekely backtesting",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
