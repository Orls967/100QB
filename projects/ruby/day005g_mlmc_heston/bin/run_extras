#!/usr/bin/env ruby
# frozen_string_literal: true

RubyVM::YJIT.enable if defined?(RubyVM::YJIT) && RubyVM::YJIT.respond_to?(:enable) && !RubyVM::YJIT.enabled?

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'mlmc_heston'

t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
heston_sweep = MlmcHeston::Complexity.compare_mlmc_vs_standard(
  model: :heston, params: MlmcHeston::Runner::HESTON_BASE,
  eps_grid: [0.04, 0.02, 0.01, 0.005], seed: MlmcHeston::MAIN_SEED
)
feller_ok_sweep = MlmcHeston::Complexity.compare_mlmc_vs_standard(
  model: :heston, params: MlmcHeston::Runner::HESTON_BASE.merge(xi: 0.25),
  eps_grid: [0.08, 0.04, 0.02, 0.01], seed: MlmcHeston::MAIN_SEED
)
gbm_anti = MlmcHeston::Antithetic.gbm_antithetic_check(
  MlmcHeston::Runner::GBM_BASE, 100.0, 1.0, level: 3, scheme: :milstein
)
dt = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0
exact = MlmcHeston::HestonCf.call_price(MlmcHeston::Runner::HESTON_BASE, 100.0, 1.0)
last = heston_sweep[:rows].last

puts format('=== day005g Extras selesai dalam %.2fs ===', dt)
puts format(
  '  Heston Feller Violated (eps=0.005): Exact=%<ex>.6f | MLMC=%<mc>.6f +- %<se>.6f | speedup=%<sp>.4fx | cx=%<cx>.2e',
  ex: exact, mc: last[:price], se: last[:se], sp: last[:speedup],
  cx: heston_sweep[:crossover_eps_extrapolated] || 0.0
)
puts format(
  '  Heston Feller OK (xi=0.25, eps=0.01): slope=%<sl>.3f | speedup=%<sp>.4fx | cx=%<cx>.2e',
  sl: feller_ok_sweep[:mlmc_cost_slope], sp: feller_ok_sweep[:rows].last[:speedup],
  cx: feller_ok_sweep[:crossover_eps_extrapolated] || 0.0
)
puts format(
  '  Diagnostik GBM Milstein Antithetic (l=3): std=%<sv>.6f | ant=%<av>.6f | ratio=%<rt>.2fx',
  sv: gbm_anti[:var_standard], av: gbm_anti[:var_antithetic], rt: gbm_anti[:reduction_ratio]
)
