# Salin file ini menjadi .env lalu isi sesuai kebutuhan (.env tidak ikut di-commit).

# Folder cache data harga (relatif terhadap root repo)
QB100_CACHE_DIR=data/cache

# Folder output grafik
QB100_FIGURES_DIR=outputs/figures

# Seed default untuk simulasi (kosongkan untuk acak)
QB100_SEED=

# Placeholder API key bila nanti butuh sumber data lain
DATA_API_KEY=
